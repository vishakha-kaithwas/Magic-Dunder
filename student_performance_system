class Student:
    def __init__(self,name,age,marks):
        self.name = name 
        self.age = age 
        self.marks = marks
        self.total = sum(marks)
        self.avg = self.total/len(marks)
    
    def __add__(self,other):
        return self.marks + other.marks
    
    def __eq__(self,other):
        return self.avg == other.avg
    
    def __str__(self):
        return f" Name: {self.name} | Total marks{self.total}"

class ScienceStudent(Student):
    def __init__(self,name,age,marks,roll_no):
        super().__init__(name,age,marks)
        self.roll_no = roll_no
class CommerceStudent(Student):
    def __init__(self,name,age,marks,main_subject):
        super().__init__(name,age,marks)
        self.main_subject = main_subject 

student1 = ScienceStudent("Vishakha",19,[99,88,77,99,88],101)
student2 = CommerceStudent("Bhumika",20,[88,77,66,55,44],"Buisness Studies")
student3 = ScienceStudent("Twinkle",20,[99,88,77,66,55],102)

print("Combined subject marks:",student1 + student2)
print("Compared avg marks:", student1 == student2)
print("Name & total marks:",student1,student2,student3)



